# Copy to .streamlit/secrets.toml (gitignored) for local runs, and paste the same content into
# Streamlit Cloud → app → Settings → Secrets for the deployed app.

GEMINI_API_KEY = "..."

# Supabase → Project Settings → API Keys. Use the Secret key (sb_secret_...): it stays on the server only.
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY = "..."

# Who may sign in. People type their name on the sign-in page (capitals don't matter).
# The name is saved as "Added by" on every receipt they add.
FAMILY = ["Bibi", "Mom", "Dad"]

# Only needed for scripts/import_sheet.py (one-off migration from the old Google Sheet).
# [gcp_service_account]
# type = "service_account"
# ...
